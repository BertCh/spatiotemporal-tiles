{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "rules": {
    "unicorn/no-new-array": "off",
    "unicorn/no-useless-spread": "off"
  },
  "ignorePatterns": [
    "target/**",
    "data/**",
    "conformance/vectors/**",
    "crates/*/tests/fixtures/**",
    "scripts/data-generation/venv-*/**",
    "node_modules/**"
  ]
}
