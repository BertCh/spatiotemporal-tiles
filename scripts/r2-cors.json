{
  "CORSRules": [
    {
      "AllowedOrigins": [
        "https://poopdeck.gl",
        "https://www.poopdeck.gl"
      ],
      "AllowedMethods": ["GET", "HEAD"],
      "AllowedHeaders": ["Range", "If-Match", "If-None-Match", "If-Modified-Since"],
      "ExposeHeaders": ["Content-Range", "Content-Length", "Accept-Ranges", "ETag", "Last-Modified"],
      "MaxAgeSeconds": 86400
    }
  ]
}
