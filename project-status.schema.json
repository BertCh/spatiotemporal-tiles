{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poopdeck.gl/project-status.schema.json",
  "title": "SpatioTemporal Tiles project status contract",
  "description": "What this repository ships and what the reference writer emits. Every field is proved against its source by scripts/check-project-status.mjs. The renderer half of the old combined file moved to the poopdeck.gl repository, which vendors this document as its `stt` block.",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "updated",
    "release",
    "toolchain",
    "archive",
    "commands",
    "repositoryOnlyCommands"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "updated": { "type": "string", "format": "date" },
    "release": {
      "type": "object",
      "required": ["rust"],
      "properties": { "rust": { "$ref": "#/$defs/version" } },
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "required": ["rust"],
      "properties": {
        "rust": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": false
    },
    "archive": {
      "type": "object",
      "required": ["writes", "reads"],
      "properties": {
        "writes": { "$ref": "#/$defs/archiveVersions" },
        "reads": {
          "type": "object",
          "required": ["formatVersions", "directoryVersions"],
          "properties": {
            "formatVersions": { "$ref": "#/$defs/versionList" },
            "directoryVersions": { "$ref": "#/$defs/versionList" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/surface" } },
    "repositoryOnlyCommands": {
      "type": "array",
      "items": { "$ref": "#/$defs/surface" }
    },
    "otherSurfaces": { "type": "array", "items": { "$ref": "#/$defs/surface" } }
  },
  "additionalProperties": false,
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "versionList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "archiveVersions": {
      "type": "object",
      "required": ["formatVersion", "directoryVersion"],
      "properties": {
        "formatVersion": { "type": "integer", "minimum": 1 },
        "directoryVersion": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "required": ["name", "support"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "support": { "enum": ["stable", "preview", "experimental"] }
      }
    }
  }
}
