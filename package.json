{
  "name": "spatiotemporal-tiles-repo",
  "version": "0.1.0",
  "description": "Repository tooling for SpatioTemporal Tiles — the Rust crates are the product; this manifest only carries the Node-based gates",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "docs:links": "node scripts/check-doc-links.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "project:check": "node scripts/check-project-status.mjs",
    "versions:check": "node scripts/sync-versions.mjs --check",
    "gen:datasets": "node scripts/gen-generate-datasets.mjs",
    "citations": "node .github/scripts/check-roadmap-citations.mjs",
    "pins": "node .github/scripts/check-golden-pins.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BertCh/spatiotemporal-tiles.git"
  },
  "keywords": [
    "tiles",
    "spatiotemporal",
    "geospatial",
    "geoparquet",
    "arrow",
    "geoarrow",
    "time-series"
  ],
  "author": "Robert Christie",
  "license": "MIT"
}
