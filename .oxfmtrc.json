{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    // GENERATED by cargo-dist (`dist generate`), and it compares the committed
    // file against what it would emit before it will run. oxfmt formats YAML,
    // so every `pnpm format` rewrote its quote style and `dist host` refused —
    // silently disabling the entire binary-distribution pipeline from
    // 2026-08-25 until 2026-08-26, with the Release workflow failing on every
    // dispatch and nobody reading the runs. Do not remove this entry.
    ".github/workflows/release.yml",
    "docs/spec/av-palettes.json",
    "docs/spec/stt-generate-datasets.json",
    "conformance/vectors/**",
    "**/tests/fixtures/**",
    "target/**",
    "data/**",
    "data-fleet/**",
    "data-fleet-*/**",
    "scripts/data-generation/venv-*/**",
    "scripts/data-generation/.venv-*/**",
    "pnpm-lock.yaml"
  ]
}
